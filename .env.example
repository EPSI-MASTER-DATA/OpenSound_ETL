# PostgreSQL credentials

POSTGRES_USER=<your_postgres_username>
POSTGRES_PASSWORD=<your_postgres_password>
POSTGRES_DB=<your_postgres_database>

# Airflow credentials

AIRFLOW__WEBSERVER__USERNAME=<your_airflow_admin_username>
AIRFLOW__WEBSERVER__PASSWORD=<your_airflow_admin_password>
AIRFLOW__CORE__EXECUTOR=<your_airflow_executor>
AIRFLOW__CORE__FERNET_KEY=<your_airflow_fernet_key>
AIRFLOW__CORE__LOAD_EXAMPLES=<your_airflow_load_examples>

# Airflow database

AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://<your_postgres_username>:<your_postgres_password>@postgres/<your_postgres_database>